# Required provider credentials. Never commit real values.
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Provider endpoints and models.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_TEXT=openai/gpt-4o-mini
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_VISION=qwen/qwen3.6-27b
DEEPGRAM_WS_URL=wss://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ru
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_CHANNELS=1
DEEPGRAM_INTERIM_RESULTS=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_VAD_EVENTS=true
DEEPGRAM_ENDPOINTING_MS=500
DEEPGRAM_UTTERANCE_END_MS=1200
DEEPGRAM_KEYTERMS="Java,Spring Boot,PostgreSQL,Kafka,Redis,Docker,Kubernetes"

# System-audio capture through the PulseAudio-compatible PipeWire server.
FFMPEG_BIN=ffmpeg
AUDIO_INPUT_FORMAT=pulse
AUDIO_SOURCE=@DEFAULT_AUDIO_SINK@.monitor
AUDIO_CHUNK_MS=100
AUDIO_QUEUE_MAX=0

# Transcript and text LLM behavior. The timeout is a fallback when Deepgram
# does not emit speech_final or UtteranceEnd.
TRANSCRIPT_WINDOW_SEC=5
MIN_UTTERANCE_CHARS=3
LLM_QUEUE_MAX=0
MAX_HISTORY_PAIRS=4
SEPARATE_HISTORIES=true
TEXT_TEMPERATURE=0.2
TEXT_MAX_TOKENS=450
TEXT_TIMEOUT_SEC=30

# Local legend retrieval. Retrieval itself is introduced in stage 6.
LEGEND_ENABLED=true
LEGEND_PATH=legend.md
LEGEND_TOP_K=2
LEGEND_CHUNK_CHARS=2200
LEGEND_MAX_CONTEXT_CHARS=4200
LEGEND_MIN_SCORE=1.6
LEGEND_RECENT_USER_TURNS=2
LEGEND_RELOAD_ON_CHANGE=true
LEGEND_DEBUG=false
CURRENT_PROJECT="АО Консалт Плюс"

# Screenshot flow. Processing itself is introduced in stage 7.
ENABLE_OCR=true
SCREENSHOT_PATH=/tmp/interview_snap.png
PID_FILE=/tmp/ai_overlay.pid
OCR_MAX_IMAGE_MB=3.5
OCR_DEBOUNCE_SEC=1
VISION_MAX_TOKENS=2500
VISION_TIMEOUT_SEC=60
