# Required provider credentials. Never commit real values.
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Provider endpoints and models.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_TEXT=google/gemini-3.5-flash-lite
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_VISION=qwen/qwen3.6-27b
DEEPGRAM_WS_URL=wss://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ru
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_CHANNELS=1
DEEPGRAM_INTERIM_RESULTS=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_VAD_EVENTS=true
DEEPGRAM_ENDPOINTING_MS=500
DEEPGRAM_UTTERANCE_END_MS=1200
DEEPGRAM_KEYTERMS="Java,Spring Boot,PostgreSQL,Kafka,Kafka consumer,offset,Redis,Docker,Kubernetes,HashMap,ConcurrentHashMap,hashCode,equals,optimistic locking,pessimistic locking,идемпотентность"

# System-audio capture through the PulseAudio-compatible PipeWire server.
FFMPEG_BIN=ffmpeg
AUDIO_INPUT_FORMAT=pulse
AUDIO_SOURCE=@DEFAULT_AUDIO_SINK@.monitor
AUDIO_CHUNK_MS=100
AUDIO_QUEUE_MAX=0
# Separate microphone channel, always labelled as candidate speech.
CANDIDATE_MIC_ENABLED=true
CANDIDATE_MIC_SOURCE=@DEFAULT_SOURCE@

# Transcript and text LLM behavior. The timeout is a fallback when Deepgram
# does not emit speech_final or UtteranceEnd.
TRANSCRIPT_WINDOW_SEC=5
MIN_UTTERANCE_CHARS=3
LLM_QUEUE_MAX=0
MAX_HISTORY_PAIRS=4
SEPARATE_HISTORIES=true
TEXT_TEMPERATURE=0.2
TEXT_MAX_TOKENS=450
TEXT_TIMEOUT_SEC=30
# Live coding uses MODEL_TEXT but needs a larger structured response.
CODING_TEMPERATURE=0.1
CODING_MAX_TOKENS=1800
CODING_TIMEOUT_SEC=60

# OpenRouter semantic retrieval. Uses OPENROUTER_API_KEY above.
# Build the ignored local vector index with:
# cargo run -- rag index knowledge/
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b
RAG_EMBEDDING_DIMENSIONS=2560
RAG_EMBEDDING_QUERY_INPUT_TYPE=search_query
RAG_EMBEDDING_DOCUMENT_INPUT_TYPE=search_document
RAG_EMBEDDING_TIMEOUT_SEC=30
RAG_TOP_K=3
RAG_MAX_CONTEXT_CHARS=4200
RAG_MIN_SCORE=0.48
RAG_REFRESH_MS=1000
RAG_FINAL_WAIT_MS=650
RAG_DEBUG=false
CURRENT_PROJECT="АО Консалт Плюс"

# Durable local training sessions. Files contain transcripts and generated code,
# stay under the ignored telemetry/ directory, and never include API keys or audio.
SESSION_LOG_ENABLED=true
SESSION_LOG_DIR=telemetry/sessions

# Screenshot flow. Processing itself is introduced in stage 7.
ENABLE_OCR=true
SCREENSHOT_PATH=/tmp/interview_snap.png
PID_FILE=/tmp/ai_overlay.pid
OCR_MAX_IMAGE_MB=3.5
OCR_DEBOUNCE_SEC=1
VISION_MAX_TOKENS=2500
VISION_TIMEOUT_SEC=60
